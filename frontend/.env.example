# Where the backend API lives, without a trailing /api - the client appends it.
#
# Leave this unset for local development: Vite proxies /api to localhost:5000,
# so a relative path is correct and nothing needs configuring.
#
# Set it on the deployment host, where the frontend and the API are served from
# different origins:
#   VITE_API_URL=https://intellicare-api.onrender.com
#
# Vite reads this at build time, not at run time, so changing it means
# rebuilding - on Vercel, that is a redeploy.
VITE_API_URL=
