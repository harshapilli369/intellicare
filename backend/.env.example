# Server
PORT=5000
NODE_ENV=development

# JWT
# At least 32 characters and not this placeholder: the server refuses to start
# otherwise, rather than rejecting every sign-in later and looking like a bug.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# MySQL. A hosted database usually gives one connection URL; set MYSQL_URL to it
# and the five variables below are ignored. Copying one string is much harder to
# get wrong than retyping a password, and a single wrong character reads as
# "access denied" rather than as a typo.
#   MYSQL_URL=mysql://user:password@host:port/database
#
# Locally, docker-compose.dev.yml builds a database from the values below, so
# whatever is set here is what the container gets:
#
#   docker compose -f backend/docker-compose.dev.yml up -d
#
# The port is 3307 rather than 3306 because a locally installed MySQL normally
# holds 3306 already. Change it if 3307 is taken as well.
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=intellicare
MYSQL_PASSWORD=intellicare
MYSQL_DATABASE=intellicare

# MongoDB (Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/intellicare

# Appointments
# The clinic's working day and how it is divided into bookable slots
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=17
APPOINTMENT_SLOT_MINUTES=30
# How close to a visit it may still be moved or cancelled (default 24)
APPOINTMENT_CHANGE_WINDOW_HOURS=24

# Appointment reminders
# How long before a visit each reminder goes out, in hours
REMINDER_OFFSETS_HOURS=24,1
# How often the scan runs (cron expression); it only sends what has not been sent
REMINDER_CRON=*/15 * * * *
# Set to false to stop the scan from starting with the server
REMINDERS_ENABLED=true

# Clinical notes
# Hours after writing that a note's author may still revise it (default 24)
NOTE_EDIT_WINDOW_HOURS=24

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
# Optional — overrides the default model
GEMINI_MODEL=gemini-3.1-flash-lite

# Email
# All of it optional. With nothing set the application still runs: reminders and
# invitations report themselves as skipped rather than failing, and an
# invitation link can be passed on by hand from the patient's record.
#
# Two ways out, and the first one wins if both are set.
#
# 1. An HTTPS provider. Either of these works from a deployment, where SMTP
#    does not: hosts commonly block outbound SMTP, and block it by swallowing
#    the connection, so a send hangs and then reports "Connection timeout" no
#    matter how correct the credentials are. Nothing blocks port 443.
#
#    Resend is the quickest to start with - an account is enough, and
#    MAIL_FROM can be onboarding@resend.dev. Without a verified domain it will
#    only deliver to the address the account was registered with, which is
#    enough to demonstrate the feature and not enough to run a clinic.
#    Key from https://resend.com -> API Keys.
RESEND_API_KEY=

#    Brevo verifies a single sender address instead and will then deliver to
#    anybody. Key from https://app.brevo.com -> SMTP & API -> API Keys.
BREVO_API_KEY=

# Who messages come from. Brevo only accepts a sender verified in the account,
# so this has to be an address set up there - not any address you like.
MAIL_FROM=IntelliCare <your_email@gmail.com>

# 2. SMTP, used when Brevo is not configured. Fine locally.
#    For Gmail, SMTP_PASS must be an App Password from an account with
#    two-factor authentication switched on - the account's own password is
#    refused, and shows up as "535 Username and Password not accepted".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# How long to wait on a provider before giving up (default 10000)
MAIL_TIMEOUT_MS=10000

# Invitations
# How long a link to set a password stays good, in days (default 7)
INVITATION_LIFETIME_DAYS=7

# Frontend URL. Two jobs: the one browser origin allowed to call this API, and
# the base of the invitation links emailed to patients - so it has to be the
# address people actually reach the site on, with the scheme included.
CLIENT_URL=http://localhost:3000
