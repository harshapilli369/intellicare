# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# MySQL (Railway in production; for local dev run docker-compose.dev.yml and use:
#   MYSQL_HOST=localhost  MYSQL_PORT=3306
#   MYSQL_USER=intellicare  MYSQL_PASSWORD=intellicare  MYSQL_DATABASE=intellicare)
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=intellicare

# MongoDB (Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/intellicare

# Appointments
# The clinic's working day and how it is divided into bookable slots
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=17
APPOINTMENT_SLOT_MINUTES=30
# How close to a visit it may still be moved or cancelled (default 24)
APPOINTMENT_CHANGE_WINDOW_HOURS=24

# Appointment reminders
# How long before a visit each reminder goes out, in hours
REMINDER_OFFSETS_HOURS=24,1
# How often the scan runs (cron expression); it only sends what has not been sent
REMINDER_CRON=*/15 * * * *
# Set to false to stop the scan from starting with the server
REMINDERS_ENABLED=true

# Clinical notes
# Hours after writing that a note's author may still revise it (default 24)
NOTE_EDIT_WINDOW_HOURS=24

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
# Optional — overrides the default model
GEMINI_MODEL=gemini-3.1-flash-lite

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
